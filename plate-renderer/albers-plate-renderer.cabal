cabal-version:      2.4
name:               albers-plate-renderer
version:            0.1.0.0
build-type:         Simple

library
  exposed-modules:    Albers.Plate
  hs-source-dirs:      src
  build-depends:
      base >=4.14 && <5,
      bytestring,
      JuicyPixels >=3.3
  default-language:    Haskell2010
  ghc-options:         -Wall

executable albers-plate-demo
  main-is:             Main.hs
  hs-source-dirs:      app
  build-depends:
      base >=4.14 && <5,
      albers-plate-renderer
  default-language:    Haskell2010
  ghc-options:         -Wall
